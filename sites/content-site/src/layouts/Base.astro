---
export interface Props {
  title: string;
  description: string;
  article?: boolean;
  published?: Date;
  modified?: Date;
}
const { title, description, article = false, published, modified } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/'); // guarantee one trailing slash -> "/profitprint/"

// Article structured data. Costs nothing, and it's how search engines pick up the
// publish date and author on a domain with no reputation of its own yet.
const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title.replace(/ — PrintProfit$/, ''),
      description,
      mainEntityOfPage: canonical,
      ...(published ? { datePublished: published.toISOString().slice(0, 10) } : {}),
      ...(modified ? { dateModified: modified.toISOString().slice(0, 10) } : {}),
      publisher: { '@type': 'Organization', name: 'PrintProfit' },
    }
  : null;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%231f7a5c'/%3E%3Ctext x='16' y='23' font-size='20' font-family='Arial' font-weight='bold' fill='white' text-anchor='middle'%3EP%3C/text%3E%3C/svg%3E" />
  <!--
    Cloudflare Web Analytics (free, privacy-first). HUMAN CHECKPOINT: add your token.
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token":"YOUR_CF_TOKEN"}'></script>
  -->
  <style>
    :root{--bg:#f6f7f9;--card:#fff;--ink:#111827;--muted:#6b7280;--line:#e5e7eb;--brand:#1f7a5c;--accent:#eef6f2}
    @media (prefers-color-scheme:dark){:root{--bg:#0e1116;--card:#161b22;--ink:#e6edf3;--muted:#9aa4b2;--line:#293039;--brand:#2ea77c;--accent:#12261e}}
    *{box-sizing:border-box}
    body{margin:0;font:17px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--ink)}
    a{color:var(--brand)}
    .wrap{max-width:760px;margin:0 auto;padding:0 18px}
    header.nav{display:flex;align-items:center;gap:14px;padding:16px 0;border-bottom:1px solid var(--line);flex-wrap:wrap}
    .logo{width:30px;height:30px;border-radius:8px;background:var(--brand);color:#fff;display:grid;place-items:center;font-weight:800;text-decoration:none}
    .nav a{color:var(--ink);text-decoration:none;font-weight:600;font-size:15px}
    .nav .spacer{margin-left:auto}
    .nav a.cta{background:var(--brand);color:#fff;padding:7px 12px;border-radius:8px}
    main{padding:26px 0 10px}
    h1{font-size:clamp(26px,4vw,36px);line-height:1.15;letter-spacing:-.5px;margin:.2em 0 .3em}
    h2{margin-top:1.7em;line-height:1.25}
    article p,article li{color:var(--ink)}
    .meta{color:var(--muted);font-size:14px;margin-bottom:8px}
    .callout{background:var(--accent);border:1px solid var(--line);border-left:4px solid var(--brand);border-radius:10px;padding:14px 16px;margin:22px 0}
    .callout a.btn{display:inline-block;margin-top:8px;background:var(--brand);color:#fff;text-decoration:none;padding:8px 13px;border-radius:8px;font-weight:700}
    .disclosure{font-size:13px;color:var(--muted);background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px 12px;margin:18px 0}
    .card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin:12px 0;text-decoration:none;color:inherit;display:block}
    .card:hover{border-color:var(--brand)}
    .card h3{margin:.1em 0 .3em}
    .card p{margin:0;color:var(--muted);font-size:15px}
    table{border-collapse:collapse;width:100%;margin:16px 0;font-size:15px}
    th,td{border:1px solid var(--line);padding:8px 10px;text-align:left}
    th{background:var(--accent)}
    footer{border-top:1px solid var(--line);margin-top:40px;padding:20px 0 50px;color:var(--muted);font-size:14px;display:flex;gap:16px;flex-wrap:wrap}
  </style>
</head>
<body>
  <div class="wrap">
    <header class="nav">
      <a href={base} class="logo">P</a>
      <a href={base}>PrintProfit</a>
      <a href={`${base}guides/`}>Guides</a>
      <span class="spacer"></span>
      <a href={`${base}tool/`} class="cta">Free calculator</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>© {year} PrintProfit</span>
      <a href={`${base}disclosure/`}>Affiliate disclosure</a>
      <a href={`${base}privacy/`}>Privacy</a>
      <a href={`${base}about/`}>About</a>
      <a href={`${base}tool/`}>Free tool</a>
    </footer>
  </div>
</body>
</html>
