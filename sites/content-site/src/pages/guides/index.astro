---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title="Guides — PrintProfit" description="Every PrintProfit guide on pricing, costing, and selling 3D prints.">
  <h1>Guides</h1>
  <p>Practical, no-hype guides for people who sell what they print.</p>
  {posts.map((p) => (
    <a class="card" href={`/guides/${p.slug}/`}>
      <h3>{p.data.title}</h3>
      <p>{p.data.description}</p>
    </a>
  ))}
</Base>
